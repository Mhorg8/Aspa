ENVIRONMENT=production
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://CHANGE_ME:CHANGE_ME@postgres.example.internal:5432/aspa
REDIS_URL=rediss://redis.example.internal:6379/0
JWT_SECRET_KEY=replace-with-a-secret-from-your-production-secret-manager
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_RATE_LIMIT_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
OTP_EXPIRE_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
READINESS_TIMEOUT_SECONDS=2
